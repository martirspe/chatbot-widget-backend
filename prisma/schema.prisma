// Esquema Prisma para la base de datos del chatbot IA.
// Define los modelos User, Session y Message, sus relaciones y campos principales.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  phone     String?
  sessions  Session[]
  agentTransfers AgentTransfer[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Session {
  id        String    @id @default(cuid())
  user      User?   @relation(fields: [userId], references: [id])
  userId    String?
  messages  Message[]
  agentTransfers AgentTransfer[]
  chatRatings ChatRating[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Message {
  id        String    @id @default(cuid())
  role      String
  text      String
  session   Session   @relation(fields: [sessionId], references: [id])
  sessionId String
  metadata  Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model AgentTransfer {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChatRating {
  id        Int      @id @default(autoincrement())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
