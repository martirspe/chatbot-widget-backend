generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  phone     String?   // Valida longitud en la lógica de negocio
  sessions  Session[] // Relación uno a muchos
}

model Session {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  user      User?     @relation(fields: [userId], references: [id])
  userId    String?
  messages  Message[] // Relación uno a muchos
}

model Message {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  role      String
  text      String    // Usa String para texto largo en PostgreSQL
  session   Session   @relation(fields: [sessionId], references: [id])
  sessionId String
  metadata  Json?
}
