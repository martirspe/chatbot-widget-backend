// Esquema Prisma para la base de datos del chatbot IA.
// Define los modelos User, Session y Message, sus relaciones y campos principales.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  phone     String?
  sessions  Session[]
}

model Session {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  user      User?     @relation(fields: [userId], references: [id])
  userId    String?
  messages  Message[]
}

model Message {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  role      String
  text      String
  session   Session   @relation(fields: [sessionId], references: [id])
  sessionId String
  metadata  Json?
}

model AgentTransfer {
  id        Int      @id @default(autoincrement())
  userId    String
  createdAt DateTime @default(now())
}

model ChatRating {
  id        Int      @id @default(autoincrement())
  sessionId String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
}
